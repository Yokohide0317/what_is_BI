---
import '../styles/global.css';
import { Picture } from 'astro:assets';
import summerFeast from '../assets/summer-feast.png';
const chapters = [
  ['market', '序論：夏の食卓'], ['genes', '遺伝子とRNA'],
  ['rnaseq', 'RNA-seqの仕組み'],
  ['fold-change', '発現量の変化'], ['p-values', 'p値と多重検定'],
  ['volcano', 'ボルケーノプロット'],
  ['gsea', 'GSEA'],
  ['review', '確認問題'],
];
const isHome = Astro.url.pathname === '/';
const isIntroduction = Astro.url.pathname === '/rna-seq/introduction/';
const isRnaSeq = Astro.url.pathname === '/rna-seq/';
const isSimulation = Astro.url.pathname === '/simulation/';
const isReferences = Astro.url.pathname === '/references/';
const title = isHome ? '解析を選ぶ' : isSimulation ? 'RNA-seq解析体験' : isReferences ? '用語と参考文献' : isIntroduction ? '序論：夏の食卓' : 'RNA-seqとは';
const pageChapters = isIntroduction ? chapters.slice(0, 1) : isRnaSeq ? chapters.slice(1) : [];
const chapterOffset = isIntroduction ? 0 : 1;
// A contents list with a single entry does not help navigation.
const showContents = isRnaSeq && pageChapters.length > 1;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={isHome ? 'データ解析のテーマを選べるページ。' : '遺伝子、RNA-seq、ボルケーノプロット、遺伝子セット、GSEAを学ぶ教材。'} />
    <meta name="theme-color" content="#f6f5ef" />
    <title>{title} | what is BI</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%231f6556'/%3E%3Cpath d='M9 22V10m7 12V16m7 6V6' stroke='%23fff' stroke-width='3'/%3E%3C/svg%3E" />
  </head>
  <body class={isHome ? 'home-page' : undefined}>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header">
      <a href="/" class="brand" aria-label="what is BI トップ"><span class="brand-icon" aria-hidden="true"><i></i><i></i><i></i></span>what is <b>BI</b><span class="brand-dot">.</span></a>
      {!isHome && <nav aria-label="サイト内"><a href="/">トップ</a><a href="/rna-seq/introduction/" aria-current={isIntroduction ? 'page' : undefined}>序論</a><a href="/rna-seq/" aria-current={isRnaSeq ? 'page' : undefined}>RNA-seq</a><a href="/simulation/" aria-current={isSimulation ? 'page' : undefined}>解析体験</a><a href="/references/#glossary">用語</a><a href="/references/#sources">参考文献</a></nav>}
    </header>
    <main id="main">
      <div class:list={['page-frame', { 'with-contents': showContents, 'simulation-layout': isSimulation, 'home-layout': isHome }]}>
        {!isReferences && (isIntroduction
          ? <header class="lesson-title intro-hero">
              <Picture
                src={summerFeast}
                formats={['webp']}
                fallbackFormat="jpeg"
                widths={[400, 800, 1200, 1672]}
                sizes="(max-width: 760px) calc(100vw - 32px), 1080px"
                alt="夏の食卓を囲む動物たちのイラスト"
                loading="eager"
                decoding="async"
              />
              <h1>{title}</h1>
            </header>
          : <header class="lesson-title"><h1>{title}</h1></header>)}
        <div class="reading-layout">
          {showContents && <aside class="contents">
            <nav aria-label="目次"><p class="contents-label">目次</p><ol>{pageChapters.map(([id, label], i) => <li><a href={`#${id}`}><span>{String(i + chapterOffset + 1).padStart(2, '0')}</span>{label}</a></li>)}</ol></nav>
          </aside>}
          <article class="lesson-body">
            {!isHome && <noscript><p class="caption">JavaScriptが無効のため、表と図は静止状態で表示しています。</p></noscript>}
            <slot />
            {(isIntroduction || isRnaSeq) && <nav class="lesson-pagination" aria-label="ページ間の移動">
              {isIntroduction
                ? <a href="/rna-seq/" rel="next">次へ：RNA-seqとは <span aria-hidden="true">→</span></a>
                : <><a href="/rna-seq/introduction/" rel="prev"><span aria-hidden="true">←</span> 序論：夏の食卓へ戻る</a><a href="/simulation/" rel="next">次へ：RNA-seq解析体験 <span aria-hidden="true">→</span></a></>}
            </nav>}
          </article>
        </div>
      </div>
    </main>
    <footer class="site-footer"><a class="brand" href="/">what is <b>BI</b><span class="brand-dot">.</span></a><a href="#main">ページの先頭へ ↑</a></footer>
    <script>
      const links = document.querySelectorAll<HTMLAnchorElement>('.contents a');
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
        }
      }, { rootMargin: '-12% 0px -65% 0px' });
      document.querySelectorAll('article > section[id]').forEach(section => observer.observe(section));
    </script>
  </body>
</html>
