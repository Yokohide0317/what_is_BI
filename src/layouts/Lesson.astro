---
import '../styles/global.css';
const chapters = [
  ['market', '序論：冬と夏の販売個数'], ['genes', '遺伝子とRNA'],
  ['knockdown', 'shRNA'], ['rnaseq', 'RNA-seqとカウント表'],
  ['fold-change', '発現量の変化'], ['p-values', 'p値と多重検定'],
  ['volcano', 'ボルケーノプロット'], ['sets', '遺伝子セット'],
  ['ora', '過剰代表解析'], ['gsea', 'GSEA'],
  ['paper', '原論文の図5'], ['review', '確認問題'],
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="遺伝子、RNA-seq、ボルケーノプロット、遺伝子セット、GSEAを学ぶ教材。" />
    <meta name="theme-color" content="#f7f8f4" />
    <title>遺伝子セットってなんだろう？ | what is BI</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%231f6556'/%3E%3Cpath d='M9 22V10m7 12V16m7 6V6' stroke='%23fff' stroke-width='3'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <header class="site-header">
      <a href="#" class="brand" aria-label="what is BI ページの先頭"><span class="brand-icon" aria-hidden="true"><i></i><i></i><i></i></span>what is <b>BI</b><span class="brand-dot">.</span></a>
      <nav aria-label="サイト内"><a href="#market">本文</a><a href="#glossary">用語</a><a href="#sources">参考文献</a></nav>
    </header>
    <main id="main">
      <header class="lesson-title"><h1>遺伝子セットってなんだろう？</h1></header>
      <div class="reading-layout">
        <aside class="contents">
          <nav aria-label="目次"><p class="contents-label">目次</p><ol>{chapters.map(([id, label], i) => <li><a href={`#${id}`}><span>{String(i + 1).padStart(2, '0')}</span>{label}</a></li>)}</ol></nav>
        </aside>
        <article class="lesson-body"><noscript><p class="caption">JavaScriptが無効のため、表と図は静止状態で表示しています。</p></noscript><slot /></article>
      </div>
    </main>
    <footer><a class="brand" href="#">what is <b>BI</b><span class="brand-dot">.</span></a><a href="#main">ページの先頭へ ↑</a></footer>
    <script>
      const links = document.querySelectorAll<HTMLAnchorElement>('.contents a');
      const observer = new IntersectionObserver(entries => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          for (const link of links) {
            if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
        }
      }, { rootMargin: '-12% 0px -65% 0px' });
      document.querySelectorAll('article > section[id]').forEach(section => observer.observe(section));
    </script>
  </body>
</html>
