---
const examples = [
  {
    src: '/images/market-to-dish.png',
    label: '食材の売上とレシピ集の図',
    alt: 'スーパーで見えるデータは食材ごとの冬・夏の売上の増減。カレー・そうめん・シチューなどレシピ集の材料セットと照らし合わせると、今どんな料理が流行っているかを推測できる、という考え方の図。',
  },
  {
    src: '/images/rna-seq-gene-set.png',
    label: 'RNA-seqと遺伝子セットの図',
    alt: 'RNA-seqで見えるデータは各サンプルの遺伝子の発現カウント。免疫応答・細胞周期・代謝など遺伝子セットと照らし合わせると、どんな働きに関わる遺伝子が変化したかを推定できる、という考え方の図。',
  },
];
---

<h3>データを、既知の集まりと照らし合わせる</h3>
<div class="market-analogy">
  {examples.map(example => <figure class="analogy-panel">
    <a href={example.src} target="_blank" rel="noopener" aria-label={`${example.label}を拡大する`}><img src={example.src} width="1672" height="941" loading="lazy" alt={example.alt} /></a>
  </figure>)}
</div>
